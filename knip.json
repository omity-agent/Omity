{
  "$schema": "./node_modules/knip/schema.json",
  "entry": ["scripts/**/*.ts", "tests/**/*.{ts,tsx}"],
  "ignoreDependencies": ["drizzle-kit"],
  "includeEntryExports": true,
  "ignoreExportsUsedInFile": false,
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "settings/**/*.ts",
    "tests/**/*.{ts,tsx}",
    "*.config.ts"
  ]
}
