{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "nursery": "warn",
    //"pedantic": "warn",
    "perf": "warn",
    "style": "warn",
    "suspicious": "warn"
  },
  "jsPlugins": [
    {
      "name": "@tanstack/query",
      "specifier": "@tanstack/eslint-plugin-query"
    },
    {
      "name": "@pandacss",
      "specifier": "@pandacss/eslint-plugin"
    }
  ],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "react",
    "react-perf",
    "oxc",
    "import",
    "jsdoc",
    "promise",
    "jest"
  ],
  "rules": {
    "@pandacss/file-not-included": "error",
    "@pandacss/no-config-function-in-source": "error",
    "@pandacss/no-debug": "warn",
    "@pandacss/no-dynamic-styling": "warn",
    "@pandacss/no-hardcoded-color": "warn",
    "@pandacss/no-invalid-nesting": "error",
    "@pandacss/no-invalid-token-paths": "error",
    "@pandacss/no-property-renaming": "warn",
    "@pandacss/no-unsafe-token-fn-usage": "warn",
    "@pandacss/no-deprecated-tokens": "warn",
    "@tanstack/query/no-rest-destructuring": "warn",
    "@tanstack/query/stable-query-client": "error",
    "@tanstack/query/no-unstable-deps": "error",
    "@tanstack/query/infinite-query-property-order": "error",
    "@tanstack/query/no-void-query-fn": "error",
    "@tanstack/query/mutation-property-order": "error",
    "typescript/no-deprecated": "error",
    "consistent-type-specifier-style": "allow",
    "exports-last": "allow",
    "filename-case": "allow",
    "func-style": "allow",
    "group-exports": "allow",
    "id-length": "allow",
    "jsx-max-depth": "allow",
    "init-declarations": "allow",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "**/*.css"
        ]
      }
    ],
    "max-lines-per-function": "allow",
    "max-nested-calls": "allow",
    "max-params": "allow",
    "max-statements": "allow",
    "new-cap": "allow",
    "no-await-in-loop": "allow",
    "no-magic-numbers": "allow",
    "no-named-export": "allow",
    "eslint/no-nested-ternary": "allow",
    "unicorn/no-nested-ternary": "allow",
    "no-nodejs-modules": "allow",
    "no-null": "allow",
    "no-ternary": "allow",
    "no-undef": "allow",
    "no-useless-undefined": "allow",
    "parameter-properties": "allow",
    "prefer-readonly-parameter-types": "allow",
    "prefer-default-export": "allow",
    "react-in-jsx-scope": "allow",
    "require-hook": "allow"
  },
  "settings": {
    "@pandacss/configPath": "./panda.config.ts"
  }
}